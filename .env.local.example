# Local file only. Copy missing names to .env.local; never commit actual secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_replace_me

# Only for project administration scripts, never website code or build output.
SUPABASE_ACCESS_TOKEN=

# Leave both empty to keep the public website in its explicit demo mode.
# Enable after deploying and verifying create-lead with real Turnstile settings.
PUBLIC_LEAD_ENDPOINT=
PUBLIC_TURNSTILE_SITE_KEY=
# Stored widget site key before public activation; not read by the website build.
TURNSTILE_SITE_KEY=

# Server-only configuration uploaded to Supabase Edge Function secrets.
# Origin contains scheme and host, with no path or trailing slash.
LEAD_SERVER_KEY_NAME=default
TURNSTILE_SECRET_KEY=
LEAD_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
