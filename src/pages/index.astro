---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroVideo from '../components/HeroVideo.astro';
import '@fontsource-variable/outfit';
import ServiceCatalogue from '../components/ServiceCatalogue.astro';
import PilotSection from '../components/PilotSection.astro';
import { site, catalogueServices, questions } from '../data/site';
import { resolveLeadFormConfig } from '../lib/lead-form-config';
const {
  endpoint: leadEndpoint,
  siteKey: turnstileSiteKey,
  live: liveForm,
} = resolveLeadFormConfig({
  development: import.meta.env.DEV,
  endpoint: import.meta.env.PUBLIC_LEAD_ENDPOINT,
  siteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
});
const assetBase = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout>
  <a class="skip-link" href="#indhold">Spring til indhold</a>
  <SiteHeader overlay />

  <main id="indhold">
    <section class="hero hero-immersive" aria-labelledby="hero-heading">
      <HeroVideo />
      <div class="container hero-content">
        <div class="hero-copy">
          <h1 id="hero-heading">
            Godt lys.<br />En smartere<br /><span>hverdag.</span>
          </h1>
          <p class="hero-description">
            Lampeopsætning, smart-home og mindre opgaver i hjemmet. Vi hjælper
            dig med en løsning, der passer til din hverdag.
          </p>
          <div class="hero-actions">
            <a class="button" href="#kontakt"
              >Beskriv din opgave <Icon name="arrow" /></a
            ><a class="text-link light-link" href="#ydelser"
              >Se vores serviceydelser <Icon name="down" size={17} /></a
            >
          </div>
          <p class="hero-reassurance">
            Uforpligtende. Vi aftaler pris og omfang, før vi går i gang.
          </p>
        </div>
        <a class="hero-note" href="#pilot">
          <span class="hero-note-label"
            >VI SØGER {site.pilotPlaces} PILOTPROJEKTER</span
          >
          <strong>Op til {site.pilotHours} timers<br />gratis arbejde.</strong>
          <span class="hero-note-terms"
            >Du betaler materialer og evt. lejeudstyr.</span
          >
          <span class="hero-note-link"
            >Se pilottilbuddet <Icon name="arrow" size={18} /></span
          >
        </a>
      </div>
    </section>

    <div class="promise-strip">
      <div class="container promises">
        <span><Icon name="check" /> Tydelige aftaler fra start</span><span
          ><Icon name="spark" /> Håndværk møder teknologi</span
        ><span><Icon name="pin" /> Lokalt i {site.area}</span>
      </div>
    </div>

    <ServiceCatalogue />

    <PilotSection />

    <section class="section process-section">
      <div class="container">
        <p class="eyebrow">FRA DEN FØRSTE IDÉ TIL DEN SIDSTE DETALJE</p><h2>
          Det starter med en samtale.
        </h2><div class="process-grid">
          <article>
            <span class="step-number">01</span><h3>Du fortæller</h3><p>
              Beskriv kort din opgave og dine ønsker. Du behøver ikke kende den
              tekniske løsning.
            </p>
          </article><article>
            <span class="step-number">02</span><h3>Vi finder mulighederne</h3><p
            >
              Vi tager en snak om omfang, materialer og om opgaven passer som
              pilotprojekt.
            </p>
          </article><article>
            <span class="step-number">03</span><h3>Vi aftaler resten</h3><p>
              Du ved, hvad der skal laves, og hvad du betaler, før vi går i
              gang.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="om-os" class="about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">MENNESKER BAG LØSNINGERNE</p><h2>
            Én fælles ambition.
          </h2><p>
            At gøre det lettere at få gode, gennemtænkte løsninger i hjemmet.
            Lys & Logik er vores møde mellem praktisk håndværk og interessen for
            det, teknologi kan gøre bedre.
          </p><p>
            Vi starter småt, gør os umage og tror på, at tillid bliver bygget én
            opgave ad gangen.
          </p><span class="about-signature"
            >Lys & Logik <span>Håndværk. Omtanke. Muligheder.</span></span
          >
        </div><div class="about-values">
          <article>
            <span>LYS</span><h3>Håndværket skal være i orden.</h3><p>
              Respekt for dit hjem, sans for detaljen og en løsning, vi kan stå
              inde for.
            </p>
          </article><article>
            <span>LOGIK</span><h3>Teknikken skal give mening.</h3><p>
              Det smarte er først smart, når det gør hverdagen nemmere for dig.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-grid">
        <div>
          <p class="eyebrow">GODT AT VIDE</p><h2>Måske tænker du …</h2><p>
            Her er svar på det vigtigste<br />om vores pilotprojekter.
          </p>
        </div><div class="faq-list">
          {
            questions.map((item) => (
              <details>
                <>
                  <summary>
                    {item.question}
                    <span class="faq-plus">
                      <Icon name="plus" />
                    </span>
                  </summary>
                  <p>{item.answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="kontakt" class="section contact-section">
      <picture class="contact-background" aria-hidden="true">
        <img
          src={`${assetBase}images/hero.webp`}
          srcset={`${assetBase}images/hero-960.webp 960w, ${assetBase}images/hero.webp 1536w`}
          sizes="100vw"
          width="1536"
          height="1024"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="container contact-grid">
        <div class="contact-intro">
          <p class="eyebrow">
            <span class="light-dot"></span> LAD OS HØRE DIN IDÉ
          </p><h2>Hvad kan vi<br />hjælpe dig med?</h2><p>
            En lampe, der mangler. En idé til smartere lys. Eller en opgave, du
            længe har tænkt på. Fortæl os lidt om den.
          </p><div class="contact-detail">
            <Icon name="pin" /><span
              >{site.area} og omegn<small>Foreløbigt arbejdsområde</small></span
            >
          </div><div class="contact-detail">
            <Icon name="mail" /><span
              ><a href={`mailto:${site.email}`}>{site.email}</a><small
                >Skriv til os om din opgave</small
              ></span
            >
          </div><div class="establishment-note">
            <strong>Vi er under etablering.</strong><p>
              Vi vurderer hver opgave fagligt og påtager os kun arbejde, der
              passer til virksomhedens aktuelle rammer.
            </p>
          </div>
        </div>
        <div id="formular" class="form-card">
          <form
            id="enquiry-form"
            data-lead-endpoint={leadEndpoint}
            data-turnstile-site-key={turnstileSiteKey}
            novalidate
          >
            <fieldset id="form-fields" disabled>
              <legend class="sr-only">Send en uforpligtende henvendelse</legend>
              <div class="form-heading">
                <h3>Fortæl om din opgave</h3><span>Ca. 2 minutter</span>
              </div>
              <p class="form-demo">
                {
                  liveForm
                    ? 'Vi gennemgår din henvendelse og kontakter dig. Du kan sende billeder i den efterfølgende dialog.'
                    : 'Demoversion · Oplysninger bliver ikke sendt eller gemt.'
                }
              </p>
              <div
                id="form-error-summary"
                class="error-summary"
                role="alert"
                hidden
              >
              </div>
              <div class="checkbox-field pilot-choice">
                <input
                  type="checkbox"
                  id="pilotRequested"
                  name="pilotRequested"
                  aria-describedby="pilot-choice-hint pilotRequested-error"
                />
                <label for="pilotRequested">
                  <strong
                    >Jeg vil gerne komme i betragtning til et pilotprojekt</strong
                  >
                  <span id="pilot-choice-hint"
                    >Valgfrit · Op til {site.pilotHours} timers gratis arbejde. Vi
                    aftaler først, om opgaven passer til pilotforløbet.</span
                  >
                </label>
              </div>
              <span class="field-error" id="pilotRequested-error"></span>
              <div class="form-row">
                <div class="field">
                  <label for="name">Dit navn</label><input
                    id="name"
                    name="name"
                    autocomplete="name"
                    placeholder="Fornavn og efternavn"
                    maxlength="100"
                    required
                    aria-describedby="name-error"
                  /><span class="field-error" id="name-error"></span>
                </div><div class="field">
                  <label for="postalCode">Postnummer</label><input
                    id="postalCode"
                    name="postalCode"
                    autocomplete="postal-code"
                    inputmode="numeric"
                    placeholder="Fx 2800"
                    maxlength="4"
                    required
                    aria-describedby="postalCode-error"
                  /><span class="field-error" id="postalCode-error"></span>
                </div>
              </div>
              <div class="field">
                <label for="email">Din e-mail</label><input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  placeholder="Så vi kan svare på din henvendelse"
                  maxlength="254"
                  required
                  aria-describedby="email-error"
                /><span class="field-error" id="email-error"></span>
              </div>
              <div class="field">
                <label for="phone">Telefon (valgfrit)</label><input
                  id="phone"
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  placeholder="Hvis det er nemmere at tage en snak"
                  maxlength="30"
                  aria-describedby="phone-error"
                /><span class="field-error" id="phone-error"></span>
              </div>
              <div class="field">
                <label for="service">Hvad drejer det sig om?</label><select
                  id="service"
                  name="service"
                  required
                  aria-describedby="service-error"
                  ><option value="">Vælg en opgavetype</option>{
                    catalogueServices.map((service) => (
                      <option value={service.id}>{service.label}</option>
                    ))
                  }<option value="andet">Noget andet</option></select
                ><span class="field-error" id="service-error"></span>
              </div>
              <div class="field">
                <label for="description">Fortæl lidt om din idé</label><textarea
                  id="description"
                  name="description"
                  rows="4"
                  placeholder="Hvad vil du gerne have hjælp til?"
                  minlength="10"
                  maxlength="1500"
                  required
                  aria-describedby="description-error"></textarea><span
                  class="field-error"
                  id="description-error"></span>
              </div>
              <div class="checkbox-field">
                <input
                  type="checkbox"
                  id="terms"
                  name="terms"
                  required
                  aria-describedby="terms-error"
                /><label for="terms"
                  >Jeg er indforstået med, at henvendelsen er uforpligtende, og
                  at pris og omfang aftales, før arbejdet starter.</label
                >
              </div><span class="field-error" id="terms-error"></span>
              {
                liveForm && (
                  <div
                    id="turnstile-widget"
                    role="group"
                    aria-label="Sikkerhedskontrol"
                  />
                )
              }
              <button class="button form-submit" type="submit"
                ><span
                  >{liveForm ? 'Send din henvendelse' : 'Prøv formularen'}</span
                >
                <Icon name="arrow" /></button
              >
              <p class="form-bottom-note">
                Uforpligtende · Vi aftaler pris og omfang, før arbejdet starter.
              </p>
              {
                liveForm && (
                  <p class="form-bottom-note">
                    Vi bruger dine oplysninger til at behandle henvendelsen og
                    kontakte dig. Undlad CPR-nummer og andre følsomme
                    oplysninger. Læs mere under Privatliv nederst på siden.
                  </p>
                )
              }
            </fieldset>
            <noscript
              ><p>Aktivér JavaScript for at bruge formularen.</p></noscript
            >
          </form>
          <div
            id="form-success"
            class="form-success"
            tabindex="-1"
            role="status"
            hidden
          >
            <span class="success-icon"><Icon name="check" size={34} /></span><p
              class="eyebrow"
            >
              TAK FOR DIN IDÉ
            </p><h3>
              {
                liveForm
                  ? 'Vi har modtaget din henvendelse.'
                  : 'Din demohenvendelse er klar.'
              }
            </h3><p>
              {
                liveForm
                  ? 'Din beskrivelse er gemt. Vi gennemgår opgaven og vender tilbage på e-mail. En aftale er først på plads, når vi har aftalt den sammen.'
                  : 'På den færdige hjemmeside vil vi her bekræfte, at vi har modtaget din henvendelse.'
              }
            </p>{
              liveForm ? (
                <p>
                  Din reference: <strong id="lead-reference" />
                </p>
              ) : (
                <p>
                  <strong>Dette er en demo. Intet er sendt eller gemt.</strong>
                </p>
              )
            }<button id="form-reset" class="button" type="button"
              >{liveForm ? 'Ny henvendelse' : 'Prøv igen'}
              <Icon name="arrow" /></button
            >
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter liveForm={liveForm} />
  <script>
    import { initializeLeadForm } from '../lib/lead-form';
    initializeLeadForm();
  </script>
</Layout>
