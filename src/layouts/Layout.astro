---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import StatisticsBanner from '../components/StatisticsBanner.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Lys & Logik — El og automation, gjort enkelt',
  description = 'Lys & Logik – lys og smarte løsninger til hjemmet. Se vores pilotprojekt og fortæl os om din opgave.',
} = Astro.props;

const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#141d23" />
    <link
      rel="icon"
      type="image/png"
      href={`${assetBase}images/favicon-v19.png`}
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <StatisticsBanner />
    <script>
      import { initAnalytics } from '../lib/analytics';
      initAnalytics();
    </script>
  </body>
</html>