---
import { services } from '../data/site';
import Icon from './Icon.astro';
const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section
  id="ydelser"
  class="section catalogue"
  aria-labelledby="catalogue-title"
>
  <div class="container">
    <div class="catalogue-heading">
      <div>
        <p class="eyebrow">DET HJÆLPER VI MED</p>
        <h2 id="catalogue-title">Små opgaver.<br />Godt håndværk.</h2>
      </div>
      <p>
        Fra lampen over spisebordet til et smart home, der er nemt at bruge. Vi
        hjælper med fem konkrete typer opgaver i hjemmet.
      </p>
    </div>

    <div class="catalogue-list">
      {
        services.map((service) => (
          <article
            class="catalogue-item"
            aria-labelledby={`service-${service.id}`}
          >
            <img
              class="catalogue-image"
              src={`${assetBase}images/${service.image}`}
              alt={service.imageAlt}
              width="960"
              height="640"
              loading="lazy"
              decoding="async"
            />
            <div class="catalogue-content">
              <div class="catalogue-name">
                <span class="catalogue-number" aria-hidden="true">
                  {service.number}
                </span>
                <h3 id={`service-${service.id}`}>{service.label}</h3>
              </div>
              <div class="catalogue-description">
                <p>{service.text}</p>
                <p class="catalogue-scope">
                  <strong>Rammer for opgaven</strong>
                  {service.scope}
                </p>
              </div>
              <a
                class="catalogue-link"
                href="#kontakt"
                data-service={service.id}
                aria-label={`Beskriv din opgave: ${service.label}`}
              >
                Beskriv din opgave <Icon name="arrow" size={18} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="catalogue-note">
      Vi udfører kun arbejde, der ikke kræver autorisation. Vi vurderer din
      opgave og de eksisterende forhold, før vi laver en aftale.
    </p>
  </div>
</section>

<style>
  .catalogue-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-bottom: 44px;
  }
  .catalogue-heading h2 {
    margin-top: 14px;
  }
  .catalogue-heading > p {
    max-width: 380px;
    font-size: 1rem;
    color: var(--muted);
  }
  .catalogue-list {
    border-top: 1px solid var(--line);
  }
  .catalogue-item {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    gap: 48px;
    align-items: start;
    padding-block: 34px;
    border-bottom: 1px solid var(--line);
  }
  .catalogue-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
  }
  .catalogue-content {
    min-width: 0;
  }
  .catalogue-description {
    margin-top: 18px;
  }
  .catalogue-name {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 18px;
  }
  .catalogue-number {
    color: #895b00;
    font-size: 0.875rem;
    font-weight: 700;
    padding-top: 4px;
  }
  h3 {
    font-size: 1.375rem;
    line-height: 1.4;
    text-wrap: balance;
  }
  .catalogue-description > p {
    font-size: 1rem;
  }
  .catalogue-description .catalogue-scope {
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 18px;
  }
  .catalogue-scope strong {
    display: block;
    font-weight: 650;
    color: var(--ink);
    margin-bottom: 3px;
  }
  .catalogue-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #805400;
    margin-top: 16px;
  }
  .catalogue-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .catalogue-note {
    max-width: 780px;
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 24px;
  }
  @media (max-width: 1000px) {
    .catalogue-item {
      gap: 28px;
    }
  }
  @media (max-width: 600px) {
    .catalogue-heading {
      display: block;
      margin-bottom: 30px;
    }
    .catalogue-heading > p {
      margin-top: 22px;
    }
    .catalogue-item {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding-block: 28px;
    }
    .catalogue-name {
      gap: 12px;
    }
  }
</style>
