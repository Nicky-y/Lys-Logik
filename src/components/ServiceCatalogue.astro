---
import { services } from '../data/site';
import Icon from './Icon.astro';
const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<section
  id="ydelser"
  class="section catalogue"
  aria-labelledby="catalogue-title"
>
  <div class="container">
    <div class="catalogue-heading">
      <div>
        <p class="eyebrow">DET HJÆLPER VI MED</p>
        <h2 id="catalogue-title">Små opgaver.<br />Godt håndværk.</h2>
      </div>
      <p>
        Fra lampen over spisebordet til et smart home, der er nemt at bruge. Vi
        hjælper med fem konkrete typer opgaver i hjemmet.
      </p>
    </div>

    <div class="catalogue-list">
      {
        services.map((service) => (
          <article
            class="catalogue-item"
            aria-labelledby={`service-${service.id}`}
          >
            <a
              class="catalogue-image-link"
              href={
                service.page
                  ? `${assetBase}services/${service.page}/`
                  : '#kontakt'
              }
              data-service={service.page ? undefined : service.id}
              aria-label={`${service.page ? 'Læs om' : 'Kontakt os om'} ${service.label}`}
            >
              <img
                class="catalogue-image"
                src={`${assetBase}images/${service.image}`}
                alt={service.imageAlt}
                width="960"
                height="640"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="catalogue-content">
              <div class="catalogue-name">
                <span class="catalogue-number" aria-hidden="true">
                  {service.number}
                </span>
                <h3 id={`service-${service.id}`}>{service.label}</h3>
              </div>
              <p class="catalogue-description">{service.teaser}</p>
              <a
                class="catalogue-link"
                href={
                  service.page
                    ? `${assetBase}services/${service.page}/`
                    : '#kontakt'
                }
                data-service={service.page ? undefined : service.id}
                aria-label={`${service.page ? 'Udforsk service' : 'Beskriv din opgave'}: ${service.label}`}
              >
                {service.page ? 'Udforsk service' : 'Beskriv din opgave'}{' '}
                <Icon name="arrow" size={18} />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="catalogue-note">
      Vi udfører kun arbejde, der ikke kræver autorisation. Vi vurderer din
      opgave og de eksisterende forhold, før vi laver en aftale.
    </p>
  </div>
</section>

<style>
  .catalogue-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    margin-bottom: 40px;
  }
  .catalogue-heading h2 {
    margin-top: 14px;
  }
  .catalogue-heading > p {
    max-width: 380px;
    color: var(--muted);
  }
  .catalogue-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px 28px;
  }
  .catalogue-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .catalogue-image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
  }
  .catalogue-image-link {
    display: block;
    border-radius: 4px;
  }
  .catalogue-image-link:hover {
    outline: 2px solid #895b00;
    outline-offset: 3px;
  }
  .catalogue-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: 22px 8px;
    border-bottom: 1px solid var(--line);
  }
  .catalogue-name {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 10px;
  }
  .catalogue-number {
    color: #895b00;
    font-size: 0.8125rem;
    font-weight: 700;
    padding-top: 5px;
  }
  h3 {
    font-size: 1.25rem;
    line-height: 1.4;
  }
  .catalogue-description {
    font-size: 0.9375rem;
    color: var(--muted);
    margin-block: 14px 16px;
  }
  .catalogue-link {
    display: inline-flex;
    align-items: center;
    align-self: start;
    gap: 12px;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
    color: #805400;
    margin-top: auto;
  }
  .catalogue-link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .catalogue-note {
    max-width: 780px;
    font-size: 0.875rem;
    color: var(--muted);
    margin-top: 28px;
  }
  @media (max-width: 1000px) {
    .catalogue-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .catalogue-heading {
      display: block;
      margin-bottom: 30px;
    }
    .catalogue-heading > p {
      margin-top: 22px;
    }
    .catalogue-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }
  }
</style>
