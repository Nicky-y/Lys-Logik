{
  "name": "lys-og-logik-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build-website.mjs",
    "website:deploy": "node scripts/deploy-website.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:intake": "playwright test --config playwright.intake.config.ts",
    "test:build:pages": "node --test tests/build/pages.test.ts",
    "app:dev": "node operations/dev.mjs",
    "app:demo": "node operations/dev.mjs --demo",
    "app:build": "tsc -p operations/tsconfig.json && vite build --config operations/vite.config.ts",
    "test:e2e:app": "playwright test --config playwright.operations.config.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "app:deploy": "npm run app:build && node operations/cloudflare.mjs deploy",
    "app:cloudflare:login": "node operations/cloudflare.mjs login --browser=false --scopes account:read user:read workers_scripts:write"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "astro": "^7.3.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
